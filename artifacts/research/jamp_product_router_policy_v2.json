{
  "policy_id": "jamp_product_router_policy_v2",
  "version": "2.0",
  "mode": "task_scoped",
  "decision_model": "fail_closed",
  "required_evidence_status": "VERIFIED",
  "default_decision": "REFUSE",
  "unknown_decision": "REFUSE",
  "contradicted_decision": "REFUSE",
  "inconclusive_decision": "REFUSE",
  "task_profiles": {
    "search_and_extraction": {
      "required_capabilities": ["C01", "C06"],
