    },
    "tool_execution_agent": {
      "required_capabilities": ["C02", "C05"],
      "operator": "AND"
    },
    "long_context_analysis": {
      "required_capabilities": ["C03", "C08"],
      "operator": "AND"
    },
    "strict_compliance_safety": {
      "required_capabilities": ["C04", "C07", "C09"],
      "operator": "AND"
    }
  },
  "qualification_rule": {
    "execute": "ALL(required_capabilities) == VERIFIED",
    "otherwise": "REFUSE_OR_ESCALATE"
  },
  "routing_contract": {
    "task_required_profile_must_be_resolved": true,
