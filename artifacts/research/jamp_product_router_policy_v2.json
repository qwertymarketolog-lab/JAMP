    "missing_capability_evidence": "REFUSE",
    "non_verified_capability": "REFUSE"
  },
  "safety_invariants": {
    "fail_closed": true,
    "synthetic_pass_forbidden": true,
    "unknown_as_pass_forbidden": true,
    "historical_evidence_as_current_pass_forbidden": true,
    "frozen_core_modification_required": false
  },
  "frozen_core": {
    "path": "src/jamp/run.py",
    "locked_blob": "0fee0e1c5c1a1548361965ac51eacdeba62bfe8a",
    "delta_allowed": false
  },
  "decision_outputs": ["EXECUTE", "REFUSE", "ESCALATE"],
  "derived_results": {
    "source": "current_raw_capability_evidence",
    "embedded_statistics": false,
    "calculation_rule": "For each model M and task T, EXECUTE iff every capability in Required(T) has raw(M,C) == VERIFIED"
  }
}