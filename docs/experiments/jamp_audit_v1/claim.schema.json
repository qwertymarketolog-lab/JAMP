{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JAMP Audit v1 Claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_id",
    "statement",
    "status",
    "source_model",
    "evidence_ids"
  ],
  "properties": {
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "OBSERVED",
        "INFERRED",
        "UNKNOWN",
        "VERIFICATION_CANDIDATE",
        "VERIFIED",
        "AMBIGUOUS"
      ]
    },
    "source_model": {
      "type": "string",
      "minLength": 1
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
