{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JAMP Audit v1 Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id",
    "source_type",
    "source_reference",
    "sha256",
    "captured_at",
    "description"
  ],
  "properties": {
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "source_type": {
      "type": "string",
      "enum": [
        "git_commit",
        "workflow_run",
        "job",
        "artifact",
        "file",
        "external_source",
        "human_observation"
      ]
    },
    "source_reference": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "captured_at": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    }
  }
}
